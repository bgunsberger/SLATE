{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slatecheck:schema:decision:0.2.0",
  "title": "SlateCheck Decision",
  "description": "An immutable decision and evidence snapshot for one proposed-use version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "proposedUseId",
    "proposedUseVersion",
    "outcome",
    "answer",
    "scopeSummary",
    "gateResults",
    "applicableRuleIds",
    "evidenceSnapshot",
    "conditions",
    "decisionOwnerId",
    "evaluationMethod",
    "decidedAt",
    "validity",
    "reassessmentTriggers",
    "evaluatedAt",
    "blockers",
    "requiredApproverIds",
    "approvals"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "proposedUseId": {
      "$ref": "#/$defs/id"
    },
    "proposedUseVersion": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "permitted",
        "permitted_with_conditions",
        "hold_information_required",
        "hold_approval_required",
        "prohibited_under_current_rules"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scopeSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "gateResults": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "result",
          "explanation",
          "ruleIds",
          "evidenceIds",
          "responsibleRole",
          "basis"
        ],
        "properties": {
          "gate": {
            "enum": [
              "inventory",
              "source_authority",
              "contributor_rights",
              "privacy_and_people_impact",
              "operation",
              "purpose_and_destination",
              "environment",
              "obligations",
              "organisation_defined"
            ]
          },
          "organisationGateName": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "satisfied",
              "conditional",
              "missing_information",
              "approval_required",
              "prohibited",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "ruleIds": {
            "$ref": "#/$defs/idList"
          },
          "evidenceIds": {
            "$ref": "#/$defs/idList"
          },
          "responsibleRole": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "evidenceIds",
                "verifiedBy",
                "scopeReferences",
                "explanation"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "inventory_verification",
                    "rights_authority",
                    "privacy_basis",
                    "technical_verification",
                    "operational_control",
                    "non_applicability"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "verifiedBy": {
                  "$ref": "#/$defs/id"
                },
                "scopeReferences": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "satisfied",
                    "conditional",
                    "not_applicable"
                  ]
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "basis": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "gate": {
                  "const": "organisation_defined"
                }
              },
              "required": [
                "gate"
              ]
            },
            "then": {
              "required": [
                "organisationGateName"
              ],
              "properties": {
                "organisationGateName": {}
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "inventory"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "source_authority"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "contributor_rights"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "privacy_and_people_impact"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "operation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "purpose_and_destination"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "environment"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "gate"
            ],
            "properties": {
              "gate": {
                "const": "obligations"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionItem"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/actionItem"
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "satisfied",
                  "waived_by_authority",
                  "failed",
                  "expired"
                ]
              },
              "dueAt": {
                "$ref": "#/$defs/dateTime"
              },
              "completionEvidenceIds": {
                "$ref": "#/$defs/idList"
              },
              "waiverEvidenceIds": {
                "$ref": "#/$defs/idList"
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "type": "object"
      }
    },
    "requiredApproverIds": {
      "$ref": "#/$defs/idList"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approverId",
          "authorityExercised",
          "status"
        ],
        "properties": {
          "approverId": {
            "$ref": "#/$defs/id"
          },
          "authorityExercised": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "requested",
              "approved",
              "declined",
              "withdrawn",
              "expired"
            ]
          },
          "recordedAt": {
            "$ref": "#/$defs/dateTime"
          },
          "evidenceId": {
            "$ref": "#/$defs/id"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "recordedAt",
                "evidenceId"
              ],
              "properties": {
                "recordedAt": {},
                "evidenceId": {}
              }
            }
          }
        ]
      }
    },
    "applicableRuleIds": {
      "$ref": "#/$defs/idList"
    },
    "evidenceSnapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "version",
          "status",
          "verifiedAt"
        ],
        "properties": {
          "recordId": {
            "$ref": "#/$defs/id"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "verifiedAt": {
            "$ref": "#/$defs/dateTime"
          },
          "integrityValue": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisionOwnerId": {
      "$ref": "#/$defs/id"
    },
    "evaluationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "profileId",
        "profileVersion"
      ],
      "properties": {
        "type": {
          "enum": [
            "manual",
            "rules_engine",
            "hybrid"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "evaluatorId": {
          "$ref": "#/$defs/id"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1
        },
        "findingRecordIds": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "decidedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validFrom"
      ],
      "properties": {
        "validFrom": {
          "$ref": "#/$defs/dateTime"
        },
        "validUntil": {
          "$ref": "#/$defs/dateTime"
        },
        "reviewAt": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "reassessmentTriggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedesDecisionId": {
      "$ref": "#/$defs/id"
    },
    "relatedDerivativeIds": {
      "$ref": "#/$defs/idList"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "actionItem": {
      "type": "object",
      "required": [
        "id",
        "description",
        "ownerId",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "ownerId": {
          "$ref": "#/$defs/id"
        },
        "timing": {
          "enum": [
            "before_processing",
            "during_processing",
            "before_release",
            "at_expiry",
            "on_trigger"
          ]
        },
        "evidenceRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
